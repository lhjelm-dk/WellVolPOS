__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
*.egg-info/
build/
dist/
pytest*.xml

# Local editor/agent tooling. .claude/launch.json carries absolute paths to this
# machine's interpreter, and the repo is meant to stay runnable by a stranger in
# one command -- so it is convenience, not configuration the project depends on.
.claude/

# The source workbook is the specification, not an input. It is large, it is the
# user's, and the parity numbers derived from it are hard-coded in
# tests/test_excel_parity.py -- so the repo does not need to carry it.
reference/*.xlsx

# Reference material that lives alongside the repo in Lars's working folder but
# is not part of it: the papers, the source workbook, and superseded plan
# versions. Kept out so `git add -A` in that folder stays clean.
/Papers/
/*.xlsx
/*.pdf
/WellVolPOS_Design_Plan_v*.md
/graphics_mockup.png
/sheetA_structure_outcomes.png
/sheetB_sweep_risk.png
/WellVolPOS_Design_Plan.md
/*.zip

# Prospect B's provenance is unconfirmed and it is treated as the licensee's, so it
# stays in the working folder and out of the repository. app.py builds its demo list
# from the files that exist, so a clone runs on prospect A alone.
/data/demo_prospectB_*.csv

# The source workbooks, in every extension they come in. The .xlsm slipped past an
# earlier *.xlsx rule and was tracked for months.
/*.xlsm
/_local/

# Launchers for the coding agent used to build this, not part of the tool.
/RUN_CLAUDE.bat
/SETUP_CLAUDE_CODE.bat

# The working record: why the code is the way it is, what was deliberately not built,
# and every trap that cost time. It is written to the coding agent, names the author
# throughout and logs the mistakes made along the way -- valuable here, not something
# to publish. Kept local (Lars, 2026-08-15). No shipped comment points at it: the
# references were reworded to carry their own reason instead.
/CLAUDE.md
