__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
*.egg-info/
build/
dist/
pytest*.xml

# Local editor/agent tooling. .claude/launch.json carries absolute paths to this
# machine's interpreter, and the repo is meant to stay runnable by a stranger in
# one command -- so it is convenience, not configuration the project depends on.
.claude/

# The source workbook is the specification, not an input. It is large, it is the
# user's, and the parity numbers derived from it are hard-coded in
# tests/test_excel_parity.py -- so the repo does not need to carry it.
reference/*.xlsx

# Reference material that lives alongside the repo in Lars's working folder but
# is not part of it: the papers, the source workbook, and superseded plan
# versions. Kept out so `git add -A` in that folder stays clean.
/Papers/
/*.xlsx
/*.pdf
/WellVolPOS_Design_Plan_v*.md
/graphics_mockup.png
/sheetA_structure_outcomes.png
/sheetB_sweep_risk.png
/WellVolPOS_Design_Plan.md
/*.zip
